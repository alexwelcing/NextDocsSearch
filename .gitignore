# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE - VSCode
.vscode/*

# dependencies
/node_modules
/.pnp
.pnp.js
package-lock.json

# testing
/coverage
/test-screenshots
/baseline-screenshots
/test-output

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local env files
.env*.local
# dotenv environment variables file
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# full-text search index: rebuilt by pnpm build (scripts/steps/pre/80-search-index.ts); the committed
# lib/generated/search-manifest.json pins its content hashes
/public/search/

# sitemaps: generated every build by scripts/steps/pre/70-sitemaps.ts
/public/sitemap*.xml
/public/video-sitemap.xml
