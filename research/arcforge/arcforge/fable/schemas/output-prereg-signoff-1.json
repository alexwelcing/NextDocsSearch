{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcforge:schema:fable-output-prereg-signoff-1",
  "title": "arc-fable-output/1: prereg_signoff",
  "description": "output.json of the PREREG sign-off (Amendment A0). status 'ok' is a signature: decision 'sign' with every check passed. Otherwise status 'refused' with the reason, and optionally the checks and the required changes. An invalid output is retried once in a fresh agent. There is no manual sign: after a refusal the orchestrator may correct exactly the defects listed and resubmit with the refusal and the diff, at most twice (`python -m arcforge.fable repair`); refusals are published verbatim, and a third refusal halts the arc at R00.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "status",
    "reason",
    "result"
  ],
  "properties": {
    "schema": {
      "const": "arc-fable-output/1"
    },
    "kind": {
      "const": "prereg_signoff"
    },
    "status": {
      "enum": [
        "ok",
        "refused"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/Result"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "null"
          },
          "result": {
            "allOf": [
              {
                "$ref": "#/$defs/Result"
              },
              {
                "properties": {
                  "decision": {
                    "const": "sign"
                  },
                  "checks": {
                    "items": {
                      "properties": {
                        "ok": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "refused"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/Result"
                  },
                  {
                    "properties": {
                      "decision": {
                        "const": "refuse"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "checks",
        "required_changes",
        "statement"
      ],
      "properties": {
        "decision": {
          "enum": [
            "sign",
            "refuse"
          ]
        },
        "checks": {
          "description": "Every sign-off check, exactly once (arcforge.fable.kinds.SIGNOFF_CHECKS).",
          "type": "array",
          "minItems": 19,
          "maxItems": 19,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "ok",
              "note"
            ],
            "properties": {
              "id": {
                "enum": [
                  "lint_passed_with_branch_expansion",
                  "i1_a0_passed_or_fallback_engaged",
                  "i3_i5_reported_with_predictions",
                  "i2_i4_scheduled",
                  "taus_equal_max_floor_mde",
                  "mde_from_baseline_variance_only",
                  "verdicts_list_every_rule_h_not_applicable",
                  "h3_falsifier_ci_hi_raw_lt_0_05_and_i6",
                  "sf_read_budget_two",
                  "falsifiers_read_only_schema_fields",
                  "a0_is_amendment_zero_and_first_witness",
                  "s0_and_r00_sets_witnessed",
                  "model_choice_record_present",
                  "contamination_precutoff_resolved",
                  "provenance_tables_present",
                  "panel_and_quarantine_reported",
                  "no_owner_field_read",
                  "no_reader_output_in_training",
                  "no_secret_material"
                ]
              },
              "ok": {
                "type": "boolean"
              },
              "note": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        },
        "required_changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  }
}
