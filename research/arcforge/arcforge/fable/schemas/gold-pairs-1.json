{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcforge:schema:gold-pairs-1",
  "title": "arc-gold-pairs/1",
  "description": "The input of a gold audit (#1 at R00, #2 at R10/R10K): 60 queries x 12 candidates, each candidate shown as the judge sees it (card, best 2 chunks, glossary entity card with person-map ids).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "audit_index", "queries"],
  "properties": {
    "schema": {"const": "arc-gold-pairs/1"},
    "run_id": {"enum": ["r00", "r10", "r10K"]},
    "audit_index": {"enum": [1, 2]},
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "stratum", "text", "candidates"],
        "properties": {
          "query_id": {"type": "string", "minLength": 1},
          "stratum": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "record_id", "card", "chunks", "entity_card"],
              "properties": {
                "candidate_id": {"type": "string", "minLength": 1},
                "record_id": {"type": "string", "minLength": 1},
                "card": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "description"],
                  "properties": {"title": {"type": "string"}, "description": {"type": "string"}}
                },
                "chunks": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
                "entity_card": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
