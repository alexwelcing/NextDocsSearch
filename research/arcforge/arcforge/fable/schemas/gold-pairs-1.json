{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcforge:schema:gold-pairs-1",
  "title": "arc-gold-pairs/1",
  "description": "The input of a gold audit (#1 at R00, #2 at R10/R10K): 60 queries x 12 candidates, each candidate shown as the judge sees it (card, best 2 chunks, and its record-local entity card: A0 rule 6, built only from that record's own mentions, so no person-map merge reaches a grade).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "audit_index", "queries"],
  "properties": {
    "schema": {"const": "arc-gold-pairs/1"},
    "run_id": {"enum": ["r00", "r10", "r10K"]},
    "audit_index": {"enum": [1, 2]},
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "stratum", "text", "candidates"],
        "properties": {
          "query_id": {"type": "string", "minLength": 1},
          "stratum": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "record_id", "card", "chunks", "entity_card", "entity_card_scope"],
              "properties": {
                "candidate_id": {"type": "string", "minLength": 1},
                "record_id": {"type": "string", "minLength": 1},
                "card": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "description"],
                  "properties": {"title": {"type": "string"}, "description": {"type": "string"}}
                },
                "chunks": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
                "entity_card": {"description": "The people this record itself names, with record-local ids; null when it names none.", "type": ["string", "null"]},
                "entity_card_scope": {"const": "record-local"}
              }
            }
          }
        }
      }
    }
  }
}
