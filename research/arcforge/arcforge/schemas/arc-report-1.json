        "via": {"const": "orchestrator"},
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/sha256OrNull"},
        "agent_session": {"type": ["string", "null"]},
        "model_reported": {"type": ["string", "null"]},
        "attempts": {"enum": [0, 1, 2]},
        "status": {"enum": ["ok", "refused", "failed", "owner_signed", "missing", null]},
        "lint_ok": {"description": "Sign-off only: whether the linted rules passed.", "type": ["boolean", "null"]}
      }
    },

