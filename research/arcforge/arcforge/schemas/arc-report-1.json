    "FableCall": {
      "description": "One orchestrator call: the packet, the accepted output (null unless status is ok), the agent session and model the harness reported, how many attempts were made (a schema-invalid or declined output is retried once in a fresh agent), and the final status (null while pending; owner_signed only for the sign-off; missing only for the end review).",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "via", "packet_sha256", "output_sha256", "agent_session", "model_reported", "attempts", "status", "lint_ok"],
      "properties": {
        "role": {"enum": ["signoff", "gold_audit_1", "gold_audit_2", "end_review"]},
