        "h1_provisional": {"$ref": "#/$defs/h1Provisional"},
        "prereg_sha256": {"$ref": "#/$defs/sha256OrNull"},
        "rules_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "VerdictsVault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_this_run", "read_index", "hybrid_minus_b2_ndcg10", "sign"],
      "properties": {
        "read_this_run": {"type": "boolean"},
        "read_index": {"enum": [1, 2, 3, null]},
        "hybrid_minus_b2_ndcg10": {"type": ["number", "null"]},
        "sign": {"enum": [-1, 0, 1, "unavailable", null]}
      }
    },
    "GatesInputs": {
      "description": "Every number a gate rule reads. I2, I3 and I5 extend the program's list so that every rule's inputs are in verdicts.json (the blind pass reads nothing else).",
      "type": "object",
      "additionalProperties": false,
      "required": ["I1", "I1_prior_pass", "I2", "I3", "I4", "I5"],
      "properties": {
        "I1": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kappa_qw_owner", "min_kendall_ci_lo"],
              "properties": {
                "kappa_qw_owner": {"type": "number", "minimum": -1, "maximum": 1},
                "min_kendall_ci_lo": {"type": "number", "minimum": -1, "maximum": 1}
              }
            },
            {"type": "null"}
          ]
        },
        "I1_prior_pass": {"description": "The I1 pass carried forward from the last run that decided it.", "type": ["boolean", "null"]},
        "I2": {
          "anyOf": [
            {"type": "object", "additionalProperties": false, "required": ["inflation_ratio"], "properties": {"inflation_ratio": {"type": "number"}}},
            {"type": "null"}
          ]
        },
        "I3": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["student_chrome_in", "student_chrome_out", "teacher_chrome_in", "teacher_chrome_out"],
              "properties": {
                "student_chrome_in": {"$ref": "#/$defs/fraction"},
                "student_chrome_out": {"$ref": "#/$defs/fraction"},
                "teacher_chrome_in": {"$ref": "#/$defs/fraction"},
                "teacher_chrome_out": {"$ref": "#/$defs/fraction"}
              }
            },
            {"type": "null"}
          ]
        },
        "I4": {
          "anyOf": [
            {"type": "object", "additionalProperties": false, "required": ["flip_rate"], "properties": {"flip_rate": {"$ref": "#/$defs/fraction"}}},
            {"type": "null"}
          ]
        },
        "I5": {
          "anyOf": [
            {"type": "object", "additionalProperties": false, "required": ["kappa_drop"], "properties": {"kappa_drop": {"type": "number"}}},
            {"type": "null"}
          ]
        }
      }
    },
    "GatesSummary": {
      "description": "Verdicts, all of them: stripped as a whole in the blind pass.",
      "type": "object",
      "additionalProperties": false,
      "required": ["I1_pass", "I1_pass_effective", "I4_pass", "futility_fired"],
      "properties": {
        "I1_pass": {"type": ["boolean", "null"]},
        "I1_pass_effective": {"type": ["boolean", "null"]},
        "I4_pass": {"type": ["boolean", "null"]},
        "futility_fired": {"type": ["boolean", "null"]}
      }
    },
    "SignoffInputs": {
      "description": "R00 only: the sign-off preconditions the R00 tail measured.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lint_ok", "report_valid", "vault_sealed", "i1_fallback_scheduled", "i2_scheduled", "i4_scheduled"],
      "properties": {
        "lint_ok": {"description": "`arcforge prereg lint --frozen` passed.", "type": ["boolean", "null"]},
        "report_valid": {"description": "report.json validates against arc-report/1.", "type": ["boolean", "null"]},
        "vault_sealed": {"description": "vault.sealed_sha256 is present and published in the bench card.", "type": ["boolean", "null"]},
        "i1_fallback_scheduled": {"description": "PREREG-A1 registered and the r01 plan carries the re-judge line.", "type": ["boolean", "null"]},
        "i2_scheduled": {"type": ["boolean", "null"]},
        "i4_scheduled": {"type": ["boolean", "null"]}
      }
    },

    "VerdictRowCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id", "hypothesis", "registered", "kind", "arm_a", "arm_b", "stratum",
        "metric", "unit", "n_queries", "n_clusters", "point", "ci_lo_raw", "ci_hi_raw",
        "holm_family", "holm_m", "holm_rank", "alpha_adj", "ci_lo_adj", "ci_hi_adj", "p_raw",
        "p_holm", "tau", "tau_floor", "mde_r00", "seed_sd", "n_seeds", "nested", "vault_read",
        "provisional", "prediction", "scores_file", "scores_sha256"
      ],
      "properties": {
        "comparison_id": {"description": "Matches rules.yaml, e.g. 'H1.c3'.", "type": "string", "pattern": "^[A-Za-z0-9]+(?:\\.[A-Za-z0-9]+)*\\.[a-z][a-z0-9]*$"},
        "hypothesis": {"$ref": "#/$defs/ruleId"},
        "registered": {"description": "false for H1.c2 and H1.c4 while I1_pass_effective is false, and for exploratory rows.", "type": "boolean"},
        "kind": {"enum": ["superiority", "guard", "bound", "ratio", "report"]},
        "arm_a": {"$ref": "#/$defs/systemId"},
        "arm_b": {"anyOf": [{"$ref": "#/$defs/systemId"}, {"type": "null"}]},
        "stratum": {"$ref": "#/$defs/rowStratum"},
        "metric": {"$ref": "#/$defs/metric"},
        "unit": {"enum": ["fraction", "ratio", "rho"]},
        "n_queries": {"type": "integer", "minimum": 1},
        "n_clusters": {"type": "integer", "minimum": 1},
        "point": {"type": "number"},
        "ci_lo_raw": {"description": "95%; two-way pigeonhole bootstrap (10k) on seed-averaged per-query scores; ratio rows: record-clustered bootstrap; P@100 rows: 5-refit x 2,000-item pooled bootstrap.", "type": "number"},
        "ci_hi_raw": {"type": "number"},
        "holm_family": {"description": "= hypothesis id.", "$ref": "#/$defs/ruleId"},
        "holm_m": {"$ref": "#/$defs/count"},
        "holm_rank": {"description": "1..m inside the family; 0 for rows outside it.", "$ref": "#/$defs/count"},
        "alpha_adj": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "ci_lo_adj": {"description": "The CI at level 1 - alpha_adj.", "type": "number"},
        "ci_hi_adj": {"type": "number"},
        "p_raw": {"description": "Paired randomization, 10k permutations, two-sided.", "type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "p_holm": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "tau": {"type": ["number", "null"]},
        "tau_floor": {"type": ["number", "null"]},
        "mde_r00": {"type": ["number", "null"]},
        "seed_sd": {"description": "SD over seeds (over refits for P@100) of the per-seed point estimate; 0 for deterministic systems.", "$ref": "#/$defs/nonNegative"},
        "n_seeds": {"type": "integer", "minimum": 1},
        "nested": {"description": "True when scores are held-out-fold scores under fold-wise champions.", "type": "boolean"},
        "vault_read": {"type": "boolean"},
        "provisional": {"type": "boolean"},
        "prediction": {"type": ["string", "null"]},
        "prediction_met": {"type": ["boolean", "null"]},
        "verdict_component": {"$ref": "#/$defs/component"},
        "scores_file": {"description": "Relative to the run directory.", "type": "string", "minLength": 1},
        "scores_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "VerdictRow": {
      "allOf": [{"$ref": "#/$defs/VerdictRowCore"}, {"required": ["prediction_met", "verdict_component"]}]
    },
    "VerdictRowBlind": {
      "allOf": [
        {"$ref": "#/$defs/VerdictRowCore"},
        {"not": {"anyOf": [{"required": ["prediction_met"]}, {"required": ["verdict_component"]}]}}
      ]
    },

    "HypothesisCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "in_scope", "provisional", "rule_id", "row_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"},
        "status": {"$ref": "#/$defs/status"},
        "in_scope": {"type": "boolean"},
        "provisional": {"type": "boolean"},
        "rule_id": {"description": "The rules.yaml rule id (= id).", "$ref": "#/$defs/ruleId"},
        "row_ids": {"description": "Empty when NOT_APPLICABLE.", "type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "if": {"properties": {"in_scope": {"const": false}}, "required": ["in_scope"]},
      "then": {"properties": {"row_ids": {"maxItems": 0}, "provisional": {"const": false}}}
    },
    "Hypothesis": {
      "allOf": [
        {"$ref": "#/$defs/HypothesisCore"},
        {"required": ["status"]},
        {
          "if": {"properties": {"in_scope": {"const": false}}, "required": ["in_scope"]},
          "then": {"properties": {"status": {"const": "NOT_APPLICABLE"}}},
          "else": {"properties": {"status": {"not": {"const": "NOT_APPLICABLE"}}}}
        }
      ]
    },
    "HypothesisBlind": {
      "allOf": [{"$ref": "#/$defs/HypothesisCore"}, {"not": {"required": ["status"]}}]
    },

    "ArcEntryCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "governing_run"],
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"},
        "final_status": {"$ref": "#/$defs/arcStatus"},
        "governing_run": {"anyOf": [{"$ref": "#/$defs/runId"}, {"type": "null"}]}
      }
    },
    "ArcEntry": {"allOf": [{"$ref": "#/$defs/ArcEntryCore"}, {"required": ["final_status"]}]},
    "ArcEntryBlind": {"allOf": [{"$ref": "#/$defs/ArcEntryCore"}, {"not": {"required": ["final_status"]}}]},

    "AdoptionDecisionCore": {
      "description": "The inputs of one fold's adoption decision, and its outcome (chosen_arm, adopted).",
      "type": "object",
      "additionalProperties": false,
      "required": ["fold", "rule", "arms"],
      "properties": {
        "fold": {"$ref": "#/$defs/fold"},
        "rule": {"enum": ["default", "squeeze"]},
        "arms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["arm_id", "gain_lfo", "guard_ok", "control", "bundle_raw"],
            "properties": {
              "arm_id": {"type": "string", "minLength": 1, "not": {"const": "parent"}},
              "gain_lfo": {"type": "number"},
              "guard_ok": {"type": "boolean"},
              "control": {"type": "boolean"},
              "bundle_raw": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]}
            }
          }
        },
        "chosen_arm": {"type": "string", "minLength": 1},
        "adopted": {"type": "boolean"}
      }
    },
    "AdoptionDecision": {"allOf": [{"$ref": "#/$defs/AdoptionDecisionCore"}, {"required": ["chosen_arm", "adopted"]}]},
    "AdoptionDecisionBlind": {
      "allOf": [
        {"$ref": "#/$defs/AdoptionDecisionCore"},
        {"not": {"anyOf": [{"required": ["chosen_arm"]}, {"required": ["adopted"]}]}}
      ]
    },

    "VerdictsDocCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run", "vault", "gates_inputs", "rows", "hypotheses", "arc_summary", "adoption", "signoff_inputs"],
      "properties": {
        "schema": {"const": "arc-verdicts/1"},
        "run": {"$ref": "#/$defs/VerdictsRun"},
        "vault": {"$ref": "#/$defs/VerdictsVault"},
        "gates_inputs": {"$ref": "#/$defs/GatesInputs"},
        "gates_summary": {"$ref": "#/$defs/GatesSummary"},
        "rows": {"type": "array"},
        "hypotheses": {"description": "Every rule in rules.yaml exactly once.", "type": "array", "minItems": 22, "maxItems": 22},
        "arc_summary": {"description": "R10/R10K only.", "type": ["array", "null"]},
        "adoption": {"description": "The adoption decisions of this run (null when none).", "type": ["array", "null"]},
        "signoff_inputs": {"description": "R00 only.", "anyOf": [{"$ref": "#/$defs/SignoffInputs"}, {"type": "null"}]}
      }
    },
    "VerdictsDoc": {
      "description": "verdicts.json (arc-verdicts/1), = report.verdicts_doc, under 25 KB.",
      "allOf": [
        {"$ref": "#/$defs/VerdictsDocCore"},
        {
          "required": ["gates_summary"],
          "properties": {
            "rows": {"items": {"$ref": "#/$defs/VerdictRow"}},
            "hypotheses": {"items": {"$ref": "#/$defs/Hypothesis"}},
            "arc_summary": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/ArcEntry"}}, {"type": "null"}]},
            "adoption": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/AdoptionDecision"}}, {"type": "null"}]}
          }
        }
      ]
    },
    "VerdictsDocBlind": {
      "description": "verdicts.json as Fable's blind pass receives it: every status, verdict component, prediction_met, the whole gates_summary, arc_summary[].final_status and the adoption outcomes stripped; everything the rules read kept.",
      "allOf": [
        {"$ref": "#/$defs/VerdictsDocCore"},
        {
          "not": {"required": ["gates_summary"]},
          "properties": {
            "rows": {"items": {"$ref": "#/$defs/VerdictRowBlind"}},
            "hypotheses": {"items": {"$ref": "#/$defs/HypothesisBlind"}},
            "arc_summary": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/ArcEntryBlind"}}, {"type": "null"}]},
            "adoption": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/AdoptionDecisionBlind"}}, {"type": "null"}]}
          }
        }
      ]
    }
  }
