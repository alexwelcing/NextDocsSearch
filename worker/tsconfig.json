{
  // The Worker and the lib/ code it imports, type-checked against the workerd runtime and the
  // bindings in wrangler.jsonc (worker-configuration.d.ts, from `pnpm cf:types`): `pnpm cf:typecheck`.
  // The root tsconfig.json (Next's) excludes worker/, so neither sees the other's ambient types.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    // Shared lib/ code imports '@/…' like the Next app does.
    "paths": { "@/*": ["../*"] }
  },
  "include": ["./**/*.ts"],
  "exclude": ["./**/*.test.ts"]
}
