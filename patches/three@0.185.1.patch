+		this.swizzle = undefined; // patched: upstream sends a bare string here, but the real WebGPU IDL for 'texture-component-swizzle' wants a { r, g, b, a } dictionary — a spec-shape mismatch that throws on any implementation validating it (see patches/three+0.185.1.patch). undefined omits the field, which is the correct 'no swizzle' default anyway.
 
 	}
 
@@ -75420,7 +75420,7 @@ class GPUTextureViewDescriptor {
