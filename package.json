{
  "name": "resume-with-openai",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "tsx scripts/run-steps.ts pre && next build --webpack && tsx scripts/run-steps.ts post",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "postinstall": "pnpm run repair:client-only",
    "repair:client-only": "node scripts/repair-client-only-package.cjs"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "endOfLine": "lf",
    "sqlKeywordCase": "lower"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.2",
    "@supabase/ssr": "^0.0.9",
    "@supabase/supabase-js": "^2.45.1",
    "client-only": "^0.0.1",
    "common-tags": "^1.8.2",
    "gray-matter": "^4.0.3",
    "next": "16.4.3",
    "openai-edge": "^1.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/common-tags": "^1.8.4",
    "@types/estree": "^1.0.5",
    "@types/mdast": "^3.0.15",
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.3",
    "github-slugger": "^2.0.0",
    "jsdom": "^27.0.0",
    "mdast": "^3.0.0",
    "mdast-util-from-markdown": "^1.3.1",
    "mdast-util-mdx": "^2.0.1",
    "mdast-util-to-markdown": "^1.5.0",
    "mdast-util-to-string": "^3.2.0",
    "micromark-extension-mdxjs": "^1.0.1",
    "opentype.js": "^2.0.0",
    "playwright": "1.61.1",
    "postcss": "^8.4.41",
    "postcss-nesting": "^12.1.5",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "unist-builder": "^3.0.1",
    "unist-util-filter": "^4.0.1",
    "vitest": "^3.2.6",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@9.7.1",
  "pnpm": {
    "overrides": {
      "vite": "7.3.5",
      "ws": "8.21.0"
    },
    "patchedDependencies": {
      "three@0.185.1": "patches/three@0.185.1.patch"
    }
  }
}
